# ===============================================================
# Ministry of Fisheries Production Configuration
# Copy this file to .env on the production server (/var/www/.../backend/.env)
# ===============================================================

# 1. Security (Set DJANGO_DEBUG to False in production)
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=generate_a_random_50_character_secret_key_here

# 2. Production Domain Hosts & Origins
DJANGO_ALLOWED_HOSTS=www.fisheries.gov.lk,fisheries.gov.lk,127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=https://www.fisheries.gov.lk,https://fisheries.gov.lk
CSRF_TRUSTED_ORIGINS=https://www.fisheries.gov.lk,https://fisheries.gov.lk
FRONTEND_URL=https://www.fisheries.gov.lk

# 3. MySQL Database Configuration
DB_ENGINE=django.db.backends.mysql
DB_NAME=fisheries_ministry_db
DB_USER=fisheries_app_user
DB_PASSWORD=SetYourStrongDatabasePasswordHere
DB_HOST=127.0.0.1
DB_PORT=3306

# 4. Email Notification Configuration (Official Ministry Relay or Gmail SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=info@fisheries.gov.lk
EMAIL_HOST_PASSWORD=your_email_app_password
DEFAULT_FROM_EMAIL=info@fisheries.gov.lk
CONTACT_RECEIVER_EMAIL=info@fisheries.gov.lk
