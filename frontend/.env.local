# Local Development Override
# When building for production, Next.js uses .env.production
# Uncomment the lines below only if you specifically want to test on your local LAN IP:
# NEXT_PUBLIC_SITE_URL=http://192.168.10.9:3000
# NEXT_PUBLIC_API_URL=http://192.168.10.9:8000/api/v1
# NEXT_PUBLIC_API_BASE_URL=http://192.168.10.9:8000
# NEXT_PUBLIC_BACKEND_URL=http://192.168.10.9:8000